# The port the API listens on.
# Render sets this automatically in production.
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
# Include your deployed frontend URL in production.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Store the JSON database on a mounted persistent disk.
# On Render, mount a disk at /var/data and uncomment this line:
# TODO_DATA_FILE=/var/data/todos.json
